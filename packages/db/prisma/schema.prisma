// LifeOS — Shared Prisma Schema
//
// Milestone 0 tables (Secret, SecretAuditLog, AuthorizationDecision) plus
// the Milestone 1 Identity/Core Object/Constitution foundation.
//
// The `User`, `Session`, `Account`, `Verification`, `TwoFactor`, and
// `Passkey` models below are GENERATED by Better Auth — do not hand-edit
// them. Regenerate via `pnpm --filter @lifeos/identity-service run
// auth:generate-schema` after changing
// services/identity-service/src/auth/auth.config.ts.
//
// Domain object tables (the Canonical Object Registry from
// docs/architecture-decisions.md, Round 1 Decision 1, extended by Round 7's
// Constitution domain group, Priority/Risk enums, Journal placement, the
// reconciled Health list, and LegalDocument, and corrected by Round 8's
// Object Model Clarification — there is no shared `Object` table) are
// modeled here starting with Milestone 1's Core Objects and Constitution
// domain groups. Every concrete model repeats the Universal Base Object
// fields (see @lifeos/domain-model's UniversalBaseObjectFields) directly as
// columns, per Round 8's implementation note — Prisma has no model
// inheritance, so this is the standard, explicit pattern rather than a
// shortcut.
//
// `Workspace` itself carries no `workspaceId` — it IS the tenancy boundary
// every other object is scoped to, not an object scoped to something else.
// Likewise `ProductConstitution` and `AIConstitution` carry no
// `workspaceId`: both are permanent, system-level singletons shared across
// every future workspace (Round 7 Decision 3 describes them as "permanent,
// changed only through explicit architectural revisions" — that's system
// configuration, not per-tenant data). `PersonalConstitution` and its 8
// sub-entities ARE workspace-scoped, since each workspace's owner has their
// own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Secrets Management Service --------------------------------------------

// A single managed secret (credential, API key, OAuth token, encryption key,
// certificate). The raw value is never stored in plaintext — see the
// EncryptionProvider abstraction in
// services/secrets-management-service/src/encryption/.

model Secret {
  id                 String    @id @default(uuid())
  workspaceId        String?
  key                String // logical name, e.g. "integration.google-calendar.oauth-token"
  scope              String // which service/integration owns this secret
  encryptedValue     Bytes
  encryptionProvider String // which EncryptionProvider encrypted this (e.g. "local", "aws-kms")
  encryptionKeyId    String // key/version identifier within that provider
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  rotatedAt          DateTime?
  revokedAt          DateTime?

  auditLogs SecretAuditLog[]

  @@unique([workspaceId, key, version])
  @@index([scope])
  @@index([workspaceId])
}

enum SecretAuditAction {
  CREATED
  ACCESSED
  ROTATED
  REVOKED
}

// Immutable audit trail for every secret lifecycle event. Never modified
// after creation — this table is part of the "Immutable History" data
// lifecycle stage (Round 3, Decision 2).

model SecretAuditLog {
  id        String            @id @default(uuid())
  secretId  String
  secret    Secret            @relation(fields: [secretId], references: [id])
  action    SecretAuditAction
  actorType String // "user" | "ai" | "automation" | "integration" | "system"
  actorId   String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([secretId])
  @@index([createdAt])
}

// --- Trust & Authorization Service ------------------------------------------

enum AuthorizationDecisionResult {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

// Every authorization evaluation is recorded here, per the Security by
// Default principle (Round 3): a decision must combine Identity, Integration
// Trust, Data Classification, Action Risk, Automation Permission, User
// Preferences, and Current Context — never a single subsystem's say-so.
// This table is the audit log for those evaluations; it does not yet
// implement the evaluation logic itself (that logic depends on Identity,
// Automation, and Integration data that don't exist until later milestones
// — see the Milestone 0 scope note in docs/engineering-roadmap.md).

model AuthorizationDecision {
  id          String                      @id @default(uuid())
  workspaceId String?
  requestId   String // correlates to the originating request/trace
  actorType   String // "user" | "ai" | "automation" | "integration"
  actorId     String?
  actionType  String // e.g. "send_email", "create_task", "execute_automation"
  objectType  String?
  objectId    String?
  result      AuthorizationDecisionResult
  reasonCode  String
  inputs      Json // snapshot of the 7 combined inputs considered, per Security by Default
  createdAt   DateTime                    @default(now())

  @@index([workspaceId])
  @@index([actorType, actorId])
  @@index([createdAt])
}

model User {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  twoFactorEnabled Boolean?    @default(false)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  passkeys         Passkey[]
  // Not managed by Better Auth's generator — added for the Workspace.owner
  // relation below. If `auth:generate-schema` is ever re-run, verify this
  // line survives the merge; re-add it if the CLI drops it.
  workspaces       Workspace[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// --- Canonical Enums (architecture-decisions.md Round 7) -------------------

// Risk Level (MINIMAL/LOW/MODERATE/HIGH/CRITICAL) is not a Prisma enum here
// because no column in this schema currently stores it directly — it's
// used by the Trust & Authorization Service as a request input (see
// services/trust-authorization-service) and travels inside JSON payloads.
// The canonical TypeScript definition lives in @lifeos/domain-model
// (RISK_VALUES / RiskLevel) — that is the single source of truth; do not
// redefine the value set here or anywhere else.
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// --- Core Objects ------------------------------------------------------
// Canonical Object Registry, Core Objects domain group (Round 1 Decision 1,
// corrected by Round 8).

// The tenancy root. V1 exposes exactly one Workspace per User to the UI
// (Round 1 Decision 3's "single personal workspace"), but the model itself
// doesn't enforce a 1:1 — that's a product decision, not a schema
// constraint, per Round 3 Decision 1's future-scalability requirement.
model Workspace {
  id        String    @id @default(uuid())
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  archivedAt     DateTime?
  version        Int       @default(1)
  priority       Priority?
  status         String?
  location       String?
  isFavorite     Boolean   @default(false)
  metadata       Json      @default("{}")
  createdBy      String
  updatedBy      String
  source         String?
  classification Int       @default(3)

  folders               Folder[]
  tags                  Tag[]
  labels                Label[]
  personalConstitution  PersonalConstitution?

  @@index([ownerId])
  @@map("workspace")
}

model Folder {
  id             String              @id @default(uuid())
  workspaceId    String
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId        String
  name           String
  parentFolderId String?
  parentFolder   Folder?             @relation("FolderTree", fields: [parentFolderId], references: [id])
  childFolders   Folder[]            @relation("FolderTree")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  archivedAt     DateTime?
  version        Int                 @default(1)
  priority       Priority?
  status         String?
  location       String?
  isFavorite     Boolean             @default(false)
  metadata       Json                @default("{}")
  createdBy      String
  updatedBy      String
  source         String?
  classification Int                 @default(3) // DataClassificationTier, see @lifeos/domain-model

  @@index([workspaceId])
  @@index([parentFolderId])
  @@map("folder")
}

model Tag {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId        String
  name           String
  color          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  archivedAt     DateTime?
  version        Int       @default(1)
  priority       Priority?
  status         String?
  location       String?
  isFavorite     Boolean   @default(false)
  metadata       Json      @default("{}")
  createdBy      String
  updatedBy      String
  source         String?
  classification Int       @default(3)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("tag")
}

model Label {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId        String
  name           String
  color          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  archivedAt     DateTime?
  version        Int       @default(1)
  priority       Priority?
  status         String?
  location       String?
  isFavorite     Boolean   @default(false)
  metadata       Json      @default("{}")
  createdBy      String
  updatedBy      String
  source         String?
  classification Int       @default(3)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("label")
}

// --- Constitution Domain -------------------------------------------------
// Canonical Object Registry, Constitution domain group (Round 7 Decision 1).
// Area: Life -> Constitution.

// System-level singleton — no workspaceId or ownerId, see file header: this
// is global system configuration, not a tenant-owned domain object, so
// those two fields genuinely don't apply (there is no "owner" of the
// product's own philosophy). Every other universal field still applies.
// Seeded at deploy time, effectively immutable except through the
// Architectural Change Process (Engineering Standards §25).
model ProductConstitution {
  id             String     @id @default(uuid())
  title          String
  purpose        String
  philosophy     String
  principles     Json // ordered list of principle statements
  longTermVision String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  archivedAt     DateTime?
  version        Int        @default(1)
  priority       Priority?
  status         String?
  location       String?
  isFavorite     Boolean    @default(false)
  metadata       Json       @default("{}")
  createdBy      String
  updatedBy      String
  source         String?
  classification Int        @default(3)

  @@map("product_constitution")
}

// System-level singleton — no workspaceId or ownerId, same reasoning as
// ProductConstitution above. Seeded at deploy time from
// architecture-decisions.md Round 6 Decision 3's example rules; effectively
// immutable except through the Architectural Change Process.
model AIConstitution {
  id             String     @id @default(uuid())
  title          String
  rules          Json // ordered list of behavioral rule statements
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  archivedAt     DateTime?
  version        Int        @default(1)
  priority       Priority?
  status         String?
  location       String?
  isFavorite     Boolean    @default(false)
  metadata       Json       @default("{}")
  createdBy      String
  updatedBy      String
  source         String?
  classification Int        @default(3)

  @@map("ai_constitution")
}

// Workspace-scoped, evolves over time, updates require explicit user
// approval (Round 4 Decision 5, Round 4 Decision 9). Starts empty — Cold
// Start Phase 1 (Round 4 Decision 5) means the Chief of Staff must function
// correctly before any of this exists.
model PersonalConstitution {
  id             String     @id @default(uuid())
  workspaceId    String     @unique
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId        String
  status         String     @default("INITIALIZATION") // Cold Start phase: INITIALIZATION | LEARNING | MATURE
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  archivedAt     DateTime?
  lastReviewedAt DateTime?
  version        Int        @default(1)
  priority       Priority?
  location       String?
  isFavorite     Boolean    @default(false)
  metadata       Json       @default("{}")
  createdBy      String
  updatedBy      String
  source         String?
  classification Int        @default(1)

  visionStatements   PersonalConstitutionVisionStatement[]
  identityStatements PersonalConstitutionIdentityStatement[]
  values             PersonalConstitutionValue[]
  nonNegotiables     PersonalConstitutionNonNegotiable[]
  decisionPrinciples PersonalConstitutionDecisionPrinciple[]
  boundaries         PersonalConstitutionBoundary[]
  successDefinitions PersonalConstitutionSuccessDefinition[]
  versions           PersonalConstitutionVersion[]

  @@map("personal_constitution")
}

model PersonalConstitutionVisionStatement {
  id                     String               @id @default(uuid())
  personalConstitutionId String
  personalConstitution   PersonalConstitution @relation(fields: [personalConstitutionId], references: [id], onDelete: Cascade)
  workspaceId            String
  ownerId                String
  title                  String
  statement              String
  supportingNotes        String?
  targetTimeHorizon      String?
  active                 Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  archivedAt             DateTime?
  version                Int                  @default(1)
  priority               Priority?
  status                 String?
  location               String?
  isFavorite             Boolean              @default(false)
  metadata               Json                 @default("{}")
  createdBy              String
  updatedBy              String
  source                 String?
  classification         Int                  @default(1)

  @@index([personalConstitutionId])
  @@map("personal_constitution_vision_statement")
}

model PersonalConstitutionIdentityStatement {
  id                     String               @id @default(uuid())
  personalConstitutionId String
  personalConstitution   PersonalConstitution @relation(fields: [personalConstitutionId], references: [id], onDelete: Cascade)
  workspaceId            String
  ownerId                String
  statement              String
  whyItMatters           String?
  priority               Priority?
  active                 Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  archivedAt             DateTime?
  version                Int                  @default(1)
  status                 String?
  location               String?
  isFavorite             Boolean              @default(false)
  metadata               Json                 @default("{}")
  createdBy              String
  updatedBy              String
  source                 String?
  classification         Int                  @default(1)

  @@index([personalConstitutionId])
  @@map("personal_constitution_identity_statement")
}

