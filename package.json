{
  "name": "lifeos",
  "version": "0.0.0",
  "private": true,
  "description": "LifeOS — AI-first personal operating system. Monorepo root.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r run test:e2e",
    "db:generate": "pnpm --filter @lifeos/db run generate",
    "db:migrate": "pnpm --filter @lifeos/db run migrate:dev"
  }
}
