# LifeOS web app — copy to .env.local and adjust for your environment.
# All service URLs are called directly from the browser (no BFF/gateway in
# Milestone 1), so they must be NEXT_PUBLIC_ to be available client-side.

NEXT_PUBLIC_IDENTITY_SERVICE_URL="http://localhost:4003"
NEXT_PUBLIC_OBJECT_SERVICE_URL="http://localhost:4004"
NEXT_PUBLIC_KNOWLEDGE_GRAPH_SERVICE_URL="http://localhost:4005"
NEXT_PUBLIC_AI_MEMORY_SERVICE_URL="http://localhost:4006"
NEXT_PUBLIC_SEARCH_SERVICE_URL="http://localhost:4007"
NEXT_PUBLIC_CHIEF_OF_STAFF_URL="http://localhost:4008"
