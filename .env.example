# LifeOS — local development environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- Shared infrastructure ---
DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Secrets Management Service ---
SECRETS_SERVICE_PORT=4001
# DEV-ONLY encryption key for the "local" EncryptionProvider (see
# services/secrets-management-service/src/encryption/README.md).
# This is NOT the production KMS/Vault integration — that provider choice
# is an open question, see docs/architecture-compliance-report.md and the
# implementation note left in this service. Generate with:
#   openssl rand -base64 32
SECRETS_LOCAL_MASTER_KEY_BASE64=""

# --- Trust & Authorization Service ---
TRUST_AUTH_SERVICE_PORT=4002

# --- Identity Service ---
IDENTITY_SERVICE_PORT=4003
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Optional per architecture-decisions.md Round 1 Decision 3
APPLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_CLIENT_SECRET=""
APPLE_APP_BUNDLE_IDENTIFIER=""
# WebAuthn relying party identity for passkeys — must match the domain
# serving the frontend in each environment.
PASSKEY_RP_ID="localhost"
PASSKEY_ORIGIN="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000"

# --- Object Service ---
OBJECT_SERVICE_PORT=4004

# --- Knowledge Graph Service ---
KNOWLEDGE_GRAPH_SERVICE_PORT=4005

# --- AI Memory Service ---
AI_MEMORY_SERVICE_PORT=4006

# --- Search Service ---
SEARCH_SERVICE_PORT=4007

# --- Chief of Staff Orchestrator ---
CHIEF_OF_STAFF_PORT=4008

# --- AI Provider ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
